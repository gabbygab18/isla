APP_NAME=Isla
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default to SQLite so the project runs with zero database setup.
# To use MySQL, switch DB_CONNECTION=mysql and fill in the credentials below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=isla
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_DRIVER=file
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@isla.com.au"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@isla.com.au
ADMIN_PASSWORD=password
